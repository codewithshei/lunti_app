# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle caches and generated build output (root app and nested projects)
**/android/.gradle/
**/android/build/
**/android/local.properties
**/android/captures/
hs_err_pid*.log

# Nested admin_dashboard build output and generated plugin links
admin_dashboard/build/
**/ephemeral/

# admin_dashboard is its own repository (github.com/codewithshei/lunti_admin).
# Keep the parent repo from treating it as an embedded git repository.
/admin_dashboard/

# Local Firebase admin credentials — never commit private keys
**/service-account*.json
functions/.env*

# Large design-reference folders (kept outside the app repository)
/LUNTI PICTURES/
/PRODUCTION AND INFO PICS/
